# Backend Environment Variables
APP_NAME=Hamara Editor API
APP_ENV=production
DEBUG=False

# Security — Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_REAL_SECRET_KEY

# Frontend URL (for CORS and TrustedHost)
# ⚠️ CHANGE THIS to your real production domain — e.g. https://editor.fitshare.tech
# If left as localhost, ALL production CORS requests will be blocked!
FRONTEND_URL=http://localhost:5173

# Server Settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Database Connection (Neon or local PostgreSQL)
DATABASE_URL=postgresql+psycopg://hamara_user:hamara_password@db:5432/hamara_db
