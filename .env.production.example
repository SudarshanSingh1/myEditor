# .env.production — COPY THIS TO .env.production AND FILL IN ALL VALUES
# NEVER commit the real .env.production file to Git!

APP_NAME=Hamara Editor API
APP_ENV=production
DEBUG=False

# ⚠️ REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_LONG_SECURE_RANDOM_STRING

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ⚠️ REQUIRED: The URL the frontend is served on — must match your real domain
FRONTEND_URL=https://editor.fitshare.tech

# Database — must match POSTGRES_* vars below
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ⚠️ REQUIRED: PostgreSQL credentials — use strong, unique passwords
POSTGRES_USER=hamara_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=hamara_db

# Email (SMTP) Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_FROM_NAME=Hamara Editor
SMTP_FROM_EMAIL=your_email@gmail.com

# OAuth Credentials (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
