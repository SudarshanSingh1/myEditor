# .env.production
APP_NAME=Hamara Editor API
APP_ENV=production
DEBUG=False

# MUST CHANGE THIS IN PRODUCTION TO A LONG SECURE STRING
SECRET_KEY=change_this_to_a_secure_random_string

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# The URL the frontend is served on
FRONTEND_URL=https://editor.fitshare.tech

# Connects to the postgres db service defined in docker-compose.prod.yml
DATABASE_URL=postgresql+psycopg://hamara_user:hamara_password@db:5432/hamara_db

# Email (SMTP) Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_FROM_NAME="Hamara Editor"
SMTP_FROM_EMAIL=your_email@gmail.com

# OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
